@echo off
rem autopilot-wrapper: generated by autopilot-setup; set-docs regenerates it.
rem codex_command for ralphex on Windows: forwards to codex-agrouter.py; %* keeps quoting intact.
if defined AUTOPILOT_PYTHON goto explicit_python
py -3 -c "pass" >nul 2>nul
if errorlevel 1 goto path_python
py -3 -X utf8 "%~dp0codex-agrouter.py" %*
exit /b %ERRORLEVEL%

:path_python
python -X utf8 "%~dp0codex-agrouter.py" %*
exit /b %ERRORLEVEL%

:explicit_python
"%AUTOPILOT_PYTHON%" -X utf8 "%~dp0codex-agrouter.py" %*
exit /b %ERRORLEVEL%

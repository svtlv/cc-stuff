{
  "description": "Delivers partner messages to a busy agent, keeps it from ending its turn while a reply is owed, and tracks turns so the waker types wake-ups only into idle tabs.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" hook-stop",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" hook-prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" hook-post-tool",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
